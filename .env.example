# KIS API 인증 정보
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env

# KIS API App Key (한국투자증권 오픈API에서 발급)
KIS_APP_KEY=your_app_key_here

# KIS API App Secret (한국투자증권 오픈API에서 발급)
KIS_APP_SECRET=your_app_secret_here

# KIS 계좌번호 (10자리 또는 8자리-2자리 형식)
# 예: 7207556001 또는 72075560-01
KIS_ACCT_STOCK=your_account_number_here

# KIS HTS ID
KIS_HTS_ID=your_hts_id_here
